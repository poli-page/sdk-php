# Copy to .env at the repo root and edit. `.env` is gitignored.
#
# examples/demo.php reads this file at the repo root; a variable set in
# your shell always wins over the file. The integration tests read the
# shell environment only: export the same variables to run them.

# Required for the demo + integration tests: a sandbox key (pp_sandbox_…)
# of an organization whose getting-started project is untouched (a fresh
# organization). Sandbox renders are watermarked and never count toward
# your quota. Get one at https://app.poli.page → your org → API keys.
POLI_PAGE_API_KEY=pp_sandbox_x

# Optional: the API base URL. Defaults to https://api.poli.page.
# POLI_PAGE_BASE_URL=https://api.poli.page
